# =====================================================================
# CONFIGURACIÓN DEL SERVIDOR DE REPORTES PDF
# =====================================================================

# Puerto de escucha del servicio (mapeado en docker-compose)
PORT=3394

# Host de escucha (0.0.0.0 para aceptar conexiones en Docker y LAN)
HOST=0.0.0.0

# Días de retención predeterminados (sobrescribibles desde Firestore)
RETENTION_DAYS_IMAGES=15
RETENTION_DAYS_PDFS=7

# Intervalo de ejecución de la tarea de limpieza (expresión cron)
# Por defecto: todos los días a las 03:00 AM
CLEANUP_CRON_SCHEDULE=0 3 * * *

# Límite máximo de tamaño de carga (en MB)
MAX_BODY_SIZE_MB=150

# Ruta personalizada de Chromium (opcional, en Debian Docker es /usr/bin/chromium)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Configuración opcional de Firebase para sincronizar parámetros
FIREBASE_PROJECT_ID=calculadora-olin
FIREBASE_CONFIG_COLLECTION=configuracion
FIREBASE_CONFIG_DOC=generadorImagenes

# Nivel de logs (info, warn, error, debug)
LOG_LEVEL=info

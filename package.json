{
  "name": "reportes-imagenes-server",
  "version": "1.0.0",
  "description": "Servidor de compilación y almacenamiento temporal de informes técnicos PDF con imágenes para Portainer, Nginx y Cloudflare",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "cleanup": "node -e \"require('./src/cleanupService').runCleanupManual()\""
  },
  "keywords": [
    "pdf",
    "puppeteer",
    "express",
    "docker",
    "portainer",
    "netdata",
    "olin",
    "reports"
  ],
  "author": "NetData PEX Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "puppeteer-core": "^22.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
